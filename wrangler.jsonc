{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auth-mail-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_STATE",
        "class_name": "AuthState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AuthState"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "keep_vars": true
}
